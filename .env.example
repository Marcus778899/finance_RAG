# Postgres. docker-compose reads these directly; the backend builds
# DATABASE_URL from them. POSTGRES_PASSWORD has no default anywhere.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finance_rag
POSTGRES_USER=finance
POSTGRES_PASSWORD=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# Generator: ollama | claude
GENERATOR_BACKEND=ollama
GENERATOR_MODEL=qwen3:4b
GENERATOR_NUM_CTX=32768

# Only needed when GENERATOR_BACKEND=claude
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Retrieval
TIMEZONE=Asia/Taipei
CONTEXT_TOKEN_BUDGET=24000
